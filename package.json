{
  "name": "@wsy320/dsh-memory-vault",
  "version": "0.4.0",
  "description": "Personal memory vault for DeepSeek Harness: weighted recall, guarded writes, self-checked frontmatter, secret redaction, and automatic git sync",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "icon": "./icon.svg",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-modules"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE",
    "locale/en.json",
    "locale/zh.json"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "license": "MIT"
}
